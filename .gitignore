# Secrets: never commit. Use .env.example for documented, non-secret placeholders.
.env*
!.env.example

# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.local

# Supabase local files
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/functions/**/.env

# Bake intermediates (raw downloads are large and reproducible)
scripts/.cache/

# npm run shot's output: regenerate anytime, not a reference image
# (reference images for comparison live in docs/look/, committed)
shots/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log
