# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Browser: the Supabase project URL and its publishable (anon) key. Public by
# design; RLS lets them read only the current_state view.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable or anon key>

# Bake only (npm run bake:routes). No VITE_ prefix, so Vite never ships it
# to the browser. The poller reads its own copy from Supabase secrets.
TRANSIT_511_API_KEY=
